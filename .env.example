# Copy this file to .env and fill in the provider credentials and test targets you use.
# Load it in your shell from the package root.
#   set -a
#   . ./.env
#   set +a
# Use the command in the provider guide to opt in to the live tests you want.

JIDO_CHAT_LIVE_PROVIDERS=

# Telegram
RUN_LIVE_TELEGRAM_TESTS=false
RUN_LIVE_TELEGRAM_UI_TESTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_TEST_FORUM_CHAT_ID=
TELEGRAM_TEST_THREAD_ID=
TELEGRAM_TEST_REACTION='👍'
TELEGRAM_CALLBACK_TIMEOUT_MS=180000
TELEGRAM_PUBLIC_API_KEEP_MESSAGES=false

# Discord
RUN_LIVE_DISCORD_TESTS=false
RUN_LIVE_DISCORD_UI=false
DISCORD_BOT_TOKEN=
DISCORD_TEST_CHANNEL_ID=
DISCORD_TEST_USER_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_TEST_CHANNEL_ID=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Signal Messenger. Use rpc for an existing signal-cli daemon or cli for a local executable.
RUN_LIVE_SIGNAL_TESTS=false
SIGNAL_TRANSPORT=rpc
SIGNAL_RPC_ENDPOINT=http://127.0.0.1:8080/api/v1/rpc
SIGNAL_ACCOUNT=
SIGNAL_TEST_RECIPIENT=
SIGNAL_CLI_PATH=signal-cli

# X. Set X_TEST_RECIPIENT_ID before enabling the DM test.
RUN_LIVE_X_TESTS=false
RUN_LIVE_X_SEND_TESTS=false
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_TEST_RECIPIENT_ID=
