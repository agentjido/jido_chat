  "assertion_sources": [
    {
      "file": "test/jido/chat/slack/protocol_test.exs",
      "cases": [
        "native send selects portable data and retains one cached provider call",
        "history and thread pages retain every item and cursor",
        "native user and thread queries use selected domain fields",
        "ephemeral operation retains native conversation and message IDs",
        "private interaction controls open a modal and retain its later conversation scope",
        "options loader receives a native request and returns portable options",
        "the same provider view ID retains separate binding and conversation scopes",
        "cancelled and expired prepared modals make zero provider calls"
      ]
    },
    {
      "file": "test/jido/chat/slack/socket_mode/req_client_test.exs",
      "cases": [
        "open_socket/2 calls apps.connections.open with the app token",
        "open_socket/2 surfaces Slack API errors explicitly",
        "open_socket/2 uses runtime base_url"
      ]
    },
    {
      "file": "test/jido/chat/slack/transport/req_client_test.exs",
      "cases": [
        "send_message/3 encodes Slack payload into form params",
        "Slack API errors are surfaced explicitly",
        "resource operations use the matching Slack Web API methods",
        "resource operations reject malformed successful responses",
        "resource operations preserve Slack API errors",
        "send_message/3 uses runtime base_url for Slack API calls",
        "send_file/3 performs Slack external upload flow",
        "download_file/2 sends bot authentication and returns raw bytes",
        "download_file/2 rejects HTML and non-success responses"
      ]
    }
  ],
