  "assertion_sources": [
    {
      "file": "test/jido/chat/x/adapter_test.exs",
      "cases": [
        "declares a valid capability matrix",
        "sends a one-to-one DM and a conversation DM",
        "posts rich payloads and remote file links as text",
        "fetches direct message history and individual messages",
        "opens a user id as a DM room",
        "normalizes account activity DM webhook events with media",
        "normalizes X API v2 DM events with included media",
        "verifies POST webhook signatures against the raw body",
        "formats CRC webhook responses",
        "routes signed X webhooks through handle_webhook/3"
      ]
    },
    {
      "file": "test/jido/chat/x/protocol_test.exs",
      "cases": [
        "#{name} matches frozen #{support} with exact calls and a cached native result",
        "#{name} matches frozen #{support} after verification",
        "zero, one and every DM item keep their order and stable identity",
        "a malformed DM is retained as a failure before the next valid DM",
        "verification, all limits and sink rejection cannot produce an accepted HTTP control",
        "CRC responses stay private and binding secrets remain captured",
        "history returns every item and cursor without private SDK state",
        "media ownership, expiry and cancellation stay private",
        "provider failure is typed and cached with one call",
        "cancelled stream has zero enumeration and provider calls",
        "HTTP mapping uses the signed body and a POST request cannot bypass acceptance"
      ]
    }
  ],
